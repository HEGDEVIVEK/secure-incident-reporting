# Copy this file to .env and fill in the values. Never commit .env.
# The database password is NOT stored here. Store it once per machine in the
# OS credential store (SR-14):
#   python -c "import keyring, getpass; keyring.set_password('secure-incident-reporting', 'atlas-db-password', getpass.getpass())"

MONGO_HOST=cluster0.xxxxxx.mongodb.net
MONGO_USERNAME=your_app_db_user
MONGO_DB_NAME=your_db_name

# Optional: set to true only on your own machine to enable /docs.
# ENABLE_API_DOCS=false
